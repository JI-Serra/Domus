{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "DOMUS_ENVIRONMENT",
        "DOMUS_RELEASE",
        "DOMUS_ENABLE_DEBUG_ROUTES"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "DOMUS_ENVIRONMENT",
        "DOMUS_RELEASE",
        "DOMUS_ENABLE_DEBUG_ROUTES"
      ]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "@domus/domain#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:db": { "cache": false }
  }
}
