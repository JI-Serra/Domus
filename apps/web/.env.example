# Copy to .env.local (local) or set in the hosting provider (staging). Never commit real values.

# --- Supabase (public: safe to expose to the browser) ---
# local:   http://127.0.0.1:54321 and the anon key printed by `pnpm supabase status`
# staging: https://kymaarzsbhiczmpazepm.supabase.co and the staging anon key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# --- Error reporting (M00-F07) ---
# Environment name attached to every report: local | staging
DOMUS_ENVIRONMENT=local
# Release identifier (e.g. git SHA). Set by CI/hosting in staging; empty locally.
DOMUS_RELEASE=
# Debug routes (/api/debug/*) are always on outside production builds.
# Set to true ONLY on staging, which runs a production build, to run the HR-00 demo.
# local: unset   staging: true (temporarily)
DOMUS_ENABLE_DEBUG_ROUTES=
